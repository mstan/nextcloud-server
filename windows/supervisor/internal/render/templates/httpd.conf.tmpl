# Generated by ncwin. Edit ncwin.toml, then restart the service.
ServerRoot "{{.Config.ApacheDir}}"
ServerName localhost
PidFile "{{.Config.TempDir}}/httpd.pid"
DefaultRuntimeDir "{{.Config.TempDir}}"
ServerTokens Prod
ServerSignature Off
TraceEnable Off
Timeout 3600
KeepAlive On
EnableSendfile Off
EnableMMAP Off
ThreadsPerChild {{.Config.Web.PHPThreads}}
MaxConnectionsPerChild 0

LoadModule authz_core_module modules/mod_authz_core.so
LoadModule authz_host_module modules/mod_authz_host.so
LoadModule access_compat_module modules/mod_access_compat.so
LoadModule alias_module modules/mod_alias.so
LoadModule dir_module modules/mod_dir.so
LoadModule mime_module modules/mod_mime.so
LoadModule env_module modules/mod_env.so
LoadModule setenvif_module modules/mod_setenvif.so
LoadModule headers_module modules/mod_headers.so
LoadModule rewrite_module modules/mod_rewrite.so
LoadModule log_config_module modules/mod_log_config.so
LoadModule deflate_module modules/mod_deflate.so
LoadModule filter_module modules/mod_filter.so
LoadModule ssl_module modules/mod_ssl.so
LoadModule http2_module modules/mod_http2.so
LoadModule socache_shmcb_module modules/mod_socache_shmcb.so
LoadModule php_module "{{.Config.PHPDir}}/php8apache2_4.dll"
PHPIniDir "{{.Config.GeneratedDir}}"
TypesConfig conf/mime.types
DirectoryIndex index.php index.html
ErrorLog "{{.Config.LogDir}}/apache.log"
LogLevel warn
LogFormat "%{end:sec}t.%{end:usec_frac}t\t%a\t%m\t%U\t%>s\t%D\t%B" ncwin
CustomLog "|\"{{.Config.ApacheDir}}/bin/rotatelogs.exe\" -n 3 \"{{.Config.LogDir}}/access.log\" 20M" ncwin
SSLSessionCache "shmcb:{{.Config.TempDir}}/ssl-cache(512000)"
SSLProtocol -all +TLSv1.2 +TLSv1.3
{{range .Ports}}
Listen {{.}}
{{end}}
{{if .Managed}}
LoadModule watchdog_module modules/mod_watchdog.so
LoadModule md_module modules/mod_md.so
MDStoreDir "{{.Config.TLSDir}}/md"
MDContactEmail "{{.Config.Web.ACMEEmail}}"
MDCertificateAgreement accepted
MDPortMap http:{{.Config.Web.HTTPPort}} https:{{.Config.Web.HTTPSPort}}
MDCAChallenges http-01 tls-alpn-01
MDNotifyCmd "{{.Config.SupervisorExe}}" web-reload --config "{{.Config.ConfigPath}}"
{{range .Managed}}
MDomain {{.}}
{{end}}
{{end}}

DocumentRoot "{{.Config.WebRoot}}"
<Directory />
    AllowOverride None
    Require all denied
</Directory>
<Directory "{{.Config.WebRoot}}">
    Options FollowSymLinks
    AllowOverride All
    Require all granted
    AcceptPathInfo On
    FallbackResource /index.php
    LimitRequestBody 0
    <FilesMatch "(?i:\.php)$">
        SetHandler application/x-httpd-php
    </FilesMatch>
    <IfModule mod_dav.c>
        Dav Off
    </IfModule>
</Directory>
<DirectoryMatch "(?i)/nextcloud/(?:config|data|lib|3rdparty|templates|build|tests)(?:/|$)">
    Require all denied
</DirectoryMatch>
<FilesMatch "(?i)^(?:\.|occ$|console\.php$|composer\.(?:json|lock)$)">
    Require all denied
</FilesMatch>
Alias /custom_apps/ "{{.Config.CustomAppsDir}}/"
<Directory "{{.Config.CustomAppsDir}}">
    Options FollowSymLinks
    AllowOverride None
    Require all granted
    LimitRequestBody 0
    <FilesMatch "(?i)\.(?:php[0-9]*|phtml|phar)(?:\.|$)">
        Require all denied
    </FilesMatch>
</Directory>
AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
Header always unset X-Powered-By
SetEnv front_controller_active true

# The first HTTP host rejects unknown Host headers.
<VirtualHost *:{{.Config.Web.HTTPPort}}>
    ServerName ncwin.invalid
    <Location />
        Require all denied
    </Location>
</VirtualHost>
{{range .Hosts}}
{{if ne .TLS "off"}}
<VirtualHost *:{{$.Config.Web.HTTPPort}}>
    ServerName {{.ServerName}}
{{template "windowsRequest" .}}
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^ {{.Redirect}}%{REQUEST_URI} [R=308,L,NE]
</VirtualHost>
{{end}}
<VirtualHost *:{{.Port}}>
    ServerName {{.ServerName}}
{{template "windowsRequest" .}}
{{if ne .TLS "off"}}
    SSLEngine On
    Protocols h2 http/1.1 acme-tls/1
    Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"
{{if eq .TLS "internal"}}
    SSLCertificateFile "{{$.Config.TLSDir}}/server.crt"
    SSLCertificateKeyFile "{{$.Config.TLSDir}}/server.key"
{{end}}
{{end}}
</VirtualHost>
{{end}}
{{define "windowsRequest"}}
    RewriteEngine On
    RewriteCond %{THE_REQUEST} "\s/+[^?\s]*(?:%20|%2e|\.)(?:/|[?\s])" [NC]
    RewriteRule ^ - [R=400,L]
{{end}}
