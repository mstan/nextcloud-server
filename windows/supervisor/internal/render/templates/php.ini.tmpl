; Generated by ncwin from windows/templates/php.ini.tmpl. Do not edit; edit ncwin.toml.
[PHP]
; All paths are rendered with forward slashes (PHP on Windows accepts them; avoids ini escape surprises).
engine = On
expose_php = Off
memory_limit = {{.MemoryLimit}}
max_execution_time = 3600
max_input_time = 3600
output_buffering = Off
upload_max_filesize = {{.UploadMax}}
post_max_size = {{.UploadMax}}
max_file_uploads = 200
default_charset = "UTF-8"
date.timezone = "{{.Timezone}}"
error_reporting = E_ALL & ~E_DEPRECATED
display_errors = Off
log_errors = On
error_log = "{{.LogDir}}/php_errors.log"
upload_tmp_dir = "{{.TempDir}}"
sys_temp_dir = "{{.TempDir}}"
session.save_path = "{{.TempDir}}"
realpath_cache_size = 4096K
realpath_cache_ttl = 600
allow_url_fopen = On

extension_dir = "{{.ExtDir}}"
extension = curl
extension = fileinfo
extension = gd
extension = gmp
extension = intl
extension = mbstring
extension = exif
extension = openssl
extension = sodium
extension = zip
extension = pdo_sqlite
extension = pdo_mysql
extension = pdo_pgsql
extension = apcu
{{- if .Imagick}}
extension = imagick
{{- end}}

[opcache]
; OPcache is built into PHP 8.5; no zend_extension line.
opcache.enable = 1
; Windows shares one OPcache segment between PHP processes; a process that
; maps php8ts.dll at a different address than the segment's creator dies with
; "Opcode handlers are unusable due to ASLR". CLI runs (occ, cron, the watcher's
; applier) are short or I/O-bound, so they get no shared cache at all, and the
; web server falls back to a file cache if it ever hits the same condition.
opcache.enable_cli = 0
opcache.file_cache = "{{.TempDir}}/opcache"
opcache.file_cache_fallback = 1
opcache.memory_consumption = 256
opcache.interned_strings_buffer = 32
opcache.max_accelerated_files = 20000
opcache.revalidate_freq = 60
opcache.save_comments = 1
opcache.jit = disable

[apcu]
apc.enabled = 1
apc.enable_cli = 1
apc.shm_size = 128M
