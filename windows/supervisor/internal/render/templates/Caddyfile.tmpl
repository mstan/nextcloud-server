# Generated by ncwin from windows/templates/Caddyfile.tmpl. Do not edit; edit ncwin.toml.
{
	admin off
	# A service must never block on trust-store prompts; `ncwin ca trust` does it explicitly.
	skip_install_trust
	persist_config off
	http_port {{.HTTPPort}}
	https_port {{.HTTPSPort}}
	storage file_system "{{.CaddyDataDir}}"
{{- if .ACMEEmail}}
	email {{.ACMEEmail}}
{{- end}}
	frankenphp {
		num_threads {{.PHPThreads}}
		# php.ini is located via the PHPRC environment variable set by ncwin.
	}
	log {
		output file "{{.LogDir}}/caddy.log" {
			roll_size 50MiB
			roll_keep 5
		}
	}
}

(nextcloud) {
	root * "{{.WebRoot}}"
	encode zstd gzip

	# JSON access log; ncwin follows it into the event ring as web.req.
	log {
		output file "{{.LogDir}}/access.log" {
			roll_size 20MiB
			roll_keep 2
		}
		format json
	}

	request_body {
		max_size {{.UploadMax}}
	}

	header {
		Strict-Transport-Security "max-age=15552000; includeSubDomains"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		X-Permitted-Cross-Domain-Policies "none"
		X-Robots-Tag "noindex, nofollow"
		-X-Powered-By
	}

	redir /.well-known/carddav /remote.php/dav/ 301
	redir /.well-known/caldav /remote.php/dav/ 301

	# Same deny list as upstream .htaccess / nginx docs.
	@forbidden {
		path /.htaccess /.user.ini /data/* /config/* /db_structure* /.xml /README /3rdparty/* /lib/* /templates/* /occ /console.php /build/* /tests/* /autotest*
	}
	respond @forbidden 404

	# App-store apps live outside the code directory (apps_paths in config.php)
	# so updates can replace the code wholesale. Serve their static assets;
	# their PHP only ever runs via index.php.
	@customApps path /custom_apps/*
	handle @customApps {
		@customAppsPHP path *.php
		respond @customAppsPHP 404
		root * "{{.StateDir}}"
		file_server
	}

	php_server {
		env front_controller_active true
	}
}
{{range .Sites}}
{{join .Addresses ", "}} {
{{- if eq .TLS "internal"}}
	tls internal
{{- end}}
	import nextcloud
}
{{end}}
