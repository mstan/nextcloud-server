<?xml version="1.0" encoding="UTF-8"?>
<!--
  SPDX-License-Identifier: AGPL-3.0-or-later

  Installer UI: WixUI_InstallDir plus one page for the ncwin settings
  (data directory, database, ports, host names, optional public domain).
  No secrets are asked for: database passwords are generated by
  `ncwin configure`, the admin password by `ncwin setup` (written to
  C:\ProgramData\ncwin\initial-admin-password.txt, Administrators only).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Fragment>
    <UI Id="NcwinUI">
      <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

      <Dialog Id="NcwinConfigDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="290" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Server settings" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Where data lives, which database to run, and how clients reach the server." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />

        <Control Id="DataDirLabel" Type="Text" X="20" Y="52" Width="330" Height="10" Text="Data directory (keep the path short):" />
        <Control Id="DataDir" Type="Edit" X="20" Y="63" Width="330" Height="17" Property="NCWIN_DATADIR" />

        <Control Id="DbLabel" Type="Text" X="20" Y="86" Width="120" Height="10" Text="Database (bundled, managed by ncwin):" />
        <Control Id="Db" Type="RadioButtonGroup" X="20" Y="97" Width="330" Height="16" Property="NCWIN_DB">
          <RadioButtonGroup Property="NCWIN_DB">
            <RadioButton Value="pgsql" X="0" Y="0" Width="100" Height="15" Text="PostgreSQL (recommended)" />
            <RadioButton Value="mysql" X="110" Y="0" Width="80" Height="15" Text="MariaDB" />
            <RadioButton Value="sqlite" X="200" Y="0" Width="130" Height="15" Text="SQLite (small/trial only)" />
          </RadioButtonGroup>
        </Control>

        <Control Id="HttpsLabel" Type="Text" X="20" Y="120" Width="70" Height="10" Text="HTTPS port:" />
        <Control Id="Https" Type="Edit" X="20" Y="131" Width="60" Height="17" Property="NCWIN_HTTPSPORT" Integer="yes" />
        <Control Id="HttpLabel" Type="Text" X="95" Y="120" Width="70" Height="10" Text="HTTP port:" />
        <Control Id="Http" Type="Edit" X="95" Y="131" Width="60" Height="17" Property="NCWIN_HTTPPORT" Integer="yes" />

        <Control Id="HostsLabel" Type="Text" X="170" Y="120" Width="180" Height="10" Text="LAN names / IPs (comma-separated):" />
        <Control Id="Hosts" Type="Edit" X="170" Y="131" Width="180" Height="17" Property="NCWIN_HOSTNAMES" />

        <Control Id="DomainLabel" Type="Text" X="20" Y="154" Width="200" Height="10" Text="Public domain (optional, gets a Let's Encrypt certificate):" />
        <Control Id="Domain" Type="Edit" X="20" Y="165" Width="160" Height="17" Property="NCWIN_DOMAIN" />
        <Control Id="EmailLabel" Type="Text" X="190" Y="154" Width="160" Height="10" Text="Let's Encrypt e-mail:" />
        <Control Id="Email" Type="Edit" X="190" Y="165" Width="160" Height="17" Property="NCWIN_ACMEEMAIL" />

        <Control Id="Hint" Type="Text" X="20" Y="190" Width="330" Height="30" NoPrefix="yes"
                 Text="A public domain needs ports 80 and 443 reachable from the internet (directly or forwarded). Everything can be changed later in C:\ProgramData\ncwin\ncwin.toml." />

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="SpawnDialog" Value="NcwinNeedEmailDlg" Condition="NCWIN_DOMAIN AND NOT NCWIN_ACMEEMAIL" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Condition="NOT NCWIN_DOMAIN OR NCWIN_ACMEEMAIL" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="NcwinNeedEmailDlg" Width="260" Height="85" Title="[ProductName] Setup" NoMinimize="yes">
        <Control Id="Text" Type="Text" X="15" Y="15" Width="230" Height="30" Text="Let's Encrypt needs an e-mail address for a public domain." />
        <Control Id="OK" Type="PushButton" X="102" Y="57" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIOK)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <!-- Insert NcwinConfigDlg between InstallDirDlg and VerifyReadyDlg (higher Order wins). -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="NcwinConfigDlg" Order="10" Condition="WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="NcwinConfigDlg" Order="10" Condition="NOT Installed" />
    </UI>

    <WixVariable Id="WixUILicenseRtf" Value="!(bindpath.installer)\license.rtf" />
  </Fragment>
</Wix>
