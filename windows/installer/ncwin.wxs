<?xml version="1.0" encoding="UTF-8"?>
<!--
  SPDX-License-Identifier: AGPL-3.0-or-later

  ncwin MSI. Built by windows/build/build-msi.ps1 from an assembled install
  tree (bind path "payload"). Installs program files only: configuration
  (C:\ProgramData\ncwin) and user data are created by ncwin itself and are
  never removed by uninstall or upgrades.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <Package Name="Nextcloud for Windows (ncwin)" Manufacturer="ncwin" Language="1033"
           Version="$(var.Version)" UpgradeCode="268f979b-b084-41e3-8af8-8ce9e726f7fb"
           Scope="perMachine" Compressed="yes" InstallerVersion="500">

    <!-- Install over the old product, then remove what it alone owned: files
         whose content did not change are skipped (component GUIDs follow the
         file path, so they are shared between versions), which makes an
         upgrade touch only what a release changed instead of every one of
         Nextcloud's ~28k files twice. The service is stopped (clean database
         shutdown), files replaced, the service started again, and ncwin runs
         `occ upgrade` before serving the new code. -->
    <MajorUpgrade Schedule="afterInstallExecute"
                  DowngradeErrorMessage="A newer version of ncwin is already installed." />
    <MediaTemplate EmbedCab="yes" MaximumUncompressedMediaSize="1024" CompressionLevel="mszip" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/mstan/nextcloud-server" />

    <!-- Installer answers (dialog in ui.wxs; also settable on the msiexec command line). -->
    <Property Id="NCWIN_DATADIR" Secure="yes" />
    <SetProperty Id="NCWIN_DATADIR" Value="[WindowsVolume]NextcloudData\" Before="CostFinalize" Sequence="first" Condition="NOT NCWIN_DATADIR" />
    <Property Id="NCWIN_DB" Value="pgsql" Secure="yes" />
    <Property Id="NCWIN_HTTPPORT" Value="80" Secure="yes" />
    <Property Id="NCWIN_HTTPSPORT" Value="443" Secure="yes" />
    <Property Id="NCWIN_HOSTNAMES" Secure="yes" />
    <SetProperty Id="NCWIN_HOSTNAMES" Value="[ComputerName]" Before="CostFinalize" Sequence="first" Condition="NOT NCWIN_HOSTNAMES" />
    <Property Id="NCWIN_DOMAIN" Secure="yes" />
    <Property Id="NCWIN_ACMEEMAIL" Secure="yes" />

    <Launch Condition="VersionNT64 AND VersionNT >= 603" Message="ncwin requires 64-bit Windows 10 / Server 2016 or later." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ncwin" />
    </StandardDirectory>

    <Feature Id="Main" Title="ncwin" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="Payload" />
      <ComponentRef Id="Service" />
      <ComponentRef Id="Firewall" />
      <ComponentRef Id="LongPaths" />
      <ComponentRef Id="FreshHtaccess" />
    </Feature>

    <!-- Nextcloud's setup appends to nextcloud\.htaccess, and Windows Installer
         never replaces an unversioned file modified after it was installed.
         Removing it first makes every install lay down the release's copy
         (the service account cannot write it afterwards; Apache reads it). -->
    <SetProperty Id="NCWIN_WEBROOT" Value="[INSTALLFOLDER]nextcloud\" Before="RemoveFiles" Sequence="execute" />
    <Component Id="FreshHtaccess" Directory="INSTALLFOLDER" Guid="3e7c1f52-8d4a-4b6e-9a0f-5c2d7e1b9a43">
      <RemoveFile Id="RmHtaccess" Property="NCWIN_WEBROOT" Name=".htaccess" On="install" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\ncwin" Name="FreshHtaccess" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <ComponentGroup Id="Payload" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.payload)\**">
        <Exclude Files="!(bindpath.payload)\ncwin.exe" />
      </Files>
    </ComponentGroup>

    <Component Id="Service" Directory="INSTALLFOLDER">
      <File Id="NcwinExe" Source="!(bindpath.payload)\ncwin.exe" KeyPath="yes" />
      <ServiceInstall Id="NcwinService" Name="ncwin" DisplayName="Nextcloud (ncwin)"
                      Description="Nextcloud server for Windows: web server, PHP, database, background jobs and file watcher."
                      Type="ownProcess" Start="auto" ErrorControl="normal" Account="NT SERVICE\ncwin"
                      Arguments="--config &quot;[CommonAppDataFolder]ncwin\ncwin.toml&quot;">
      </ServiceInstall>
      <ServiceControl Id="NcwinControl" Name="ncwin" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
    </Component>

    <Component Id="Firewall" Directory="INSTALLFOLDER" Guid="b1074d75-56cf-45b4-9dc2-778251d529e9">
      <!-- Per program, not per port: ports in ncwin.toml can change after install.
           TCP for HTTP/1.1+2. The databases bind 127.0.0.1 only. -->
      <fire:FirewallException Id="FwApacheTcp" Name="Nextcloud (ncwin) Apache web" Program="[INSTALLFOLDER]apache\bin\httpd.exe" Protocol="tcp" Scope="any" Profile="all" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\ncwin" Name="FirewallApache" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Nextcloud paths (user/files/folder/versions/...) routinely exceed MAX_PATH. -->
    <Component Id="LongPaths" Directory="INSTALLFOLDER" Guid="9d1f8e3a-2b7c-4c55-8f0d-1e6a7b3c4d22" Permanent="yes">
      <RegistryValue Root="HKLM" Key="SYSTEM\CurrentControlSet\Control\FileSystem" Name="LongPathsEnabled" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Write ncwin.toml (kept if it exists) and provision Nextcloud. Both run
         as SYSTEM after the service account exists (ACLs) and before the
         service starts. setup does nothing once Nextcloud is installed
         (upgrades: the service runs `occ upgrade` itself), so an upgrade over
         an install whose setup failed finishes it. Its output goes to
         C:\ProgramData\ncwin\log\setup.log. Paths get a trailing "." so the
         MSI's trailing backslash cannot escape the closing quote. -->
    <!-- Delayed auto-start, pre-shutdown time for a clean DB stop, restart-on-failure
         and the event-log source, via the SCM API (MSI's ServiceConfig table is
         unreliable); also the daily automatic-update scheduled task. -->
    <CustomAction Id="NcwinServiceConfig" FileRef="NcwinExe" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="service-config --config &quot;[CommonAppDataFolder]ncwin\ncwin.toml&quot;" />
    <!-- Uninstall only (not the removal half of an upgrade): delete the daily update task. -->
    <CustomAction Id="NcwinServiceUnconfig" FileRef="NcwinExe" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="service-unconfig" />
    <CustomAction Id="NcwinConfigure" FileRef="NcwinExe" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="configure --config &quot;[CommonAppDataFolder]ncwin\ncwin.toml&quot; --install-dir &quot;[INSTALLFOLDER].&quot; --state-dir &quot;[CommonAppDataFolder]ncwin&quot; --data-dir &quot;[NCWIN_DATADIR].&quot; --db [NCWIN_DB] --http-port [NCWIN_HTTPPORT] --https-port [NCWIN_HTTPSPORT] --hostnames &quot;[NCWIN_HOSTNAMES]&quot; --public-domain &quot;[NCWIN_DOMAIN]&quot; --acme-email &quot;[NCWIN_ACMEEMAIL]&quot;" />
    <CustomAction Id="NcwinSetup" FileRef="NcwinExe" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="setup --config &quot;[CommonAppDataFolder]ncwin\ncwin.toml&quot; --generate-admin-pass --if-not-installed" />

    <InstallExecuteSequence>
      <Custom Action="NcwinServiceUnconfig" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="NcwinServiceConfig" After="InstallServices" Condition="NOT REMOVE" />
      <Custom Action="NcwinConfigure" After="NcwinServiceConfig" Condition="NOT REMOVE" />
      <Custom Action="NcwinSetup" After="NcwinConfigure" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

    <UIRef Id="NcwinUI" />
  </Package>
</Wix>
